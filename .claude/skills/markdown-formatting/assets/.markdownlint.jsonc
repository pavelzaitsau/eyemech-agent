// markdownlint configuration for the markdown-formatting skill.
// Run with: markdownlint-cli2 "**/*.md"
{
  "default": true,

  // Prose is unwrapped here: one paragraph per line. A line-length rule that
  // fails on every line teaches everyone to ignore the linter.
  "MD013": false,

  // One style each, so a repository does not drift into two.
  "MD003": { "style": "atx" },
  "MD004": { "style": "dash" },
  "MD035": { "style": "---" },
  "MD046": { "style": "fenced" },
  "MD048": { "style": "backtick" },
  "MD049": { "style": "underscore" },
  "MD050": { "style": "asterisk" },

  // Both numbering styles are allowed, and one list may not mix them. The
  // choice is explained in the skill: sequential when the text cites item
  // numbers, all-ones when diff stability matters more.
  "MD029": { "style": "one_or_ordered" },

  // Two spaces under the parent text, which is where a reader expects a child.
  "MD007": { "indent": 2 },

  // Duplicate headings are fine across sections, not within one.
  "MD024": { "siblings_only": true },

  // Markdown has no syntax for these four, so HTML is the only option.
  "MD033": { "allowed_elements": ["br", "sub", "sup", "kbd"] },

  // A table row that does not match the header loses data silently.
  "MD056": true,
  "MD055": { "style": "leading_and_trailing" },

  // Column width is not a defect. The rendered table is identical whether the
  // source is padded or compact, and enforcing one produced more noise than
  // every other rule here combined.
  "MD060": false
}
